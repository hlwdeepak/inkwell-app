# Copy this file to .env and fill in real values before running.

# ---- App ----
PORT=3000
APP_URL=http://localhost:3000          # public base URL once deployed, e.g. https://mail.yourdomain.com
ADMIN_API_KEY=change-me-to-a-long-random-string   # protects the /api admin routes

# ---- Compliance (CAN-SPAM requires a real physical mailing address in every
# commercial email; this is not optional) ----
COMPANY_NAME="Your Business Name"
COMPANY_ADDRESS="123 Main St, Springfield, ST 12345"

# ---- Sending identity ----
FROM_NAME="Your Name"
FROM_EMAIL=you@yourdomain.com          # must be on a domain with SPF/DKIM configured (see README)
REPLY_TO_EMAIL=you@yourdomain.com

# ---- Email provider: choose ONE by setting EMAIL_PROVIDER ----
# Options: resend | ses_smtp | smtp
EMAIL_PROVIDER=resend

# --- Resend (https://resend.com) ---
RESEND_API_KEY=

# --- Amazon SES (via SMTP interface) or any SMTP provider (Postmark, Mailgun, etc.) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---- Sending rate control ----
SEND_BATCH_SIZE=10          # emails per batch
SEND_BATCH_DELAY_MS=1000    # pause between batches, protects sender reputation
